include README.md CHANGELOG.md requirements.txt requirements-dev.txt
recursive-include docs *.md
recursive-include config *.json
recursive-include tests *.py
prune data
prune models
prune weights
prune cache
prune runs
prune outputs
prune reports
prune backup
prune .git
prune .vscode
global-exclude __pycache__ *.py[cod] *.wav *.npz *.pkl .DS_Store
