include README.md CONTRIBUTING.md SECURITY.md CHANGELOG.md
include requirements.txt requirements-dev.txt
recursive-include docs *.md
recursive-include examples *.csv *.md
recursive-include tests *.py
recursive-include scripts *.py
prune data
prune models
prune cache
prune runs
prune outputs
prune reports
prune backup
prune .git
prune .vscode
global-exclude __pycache__ *.py[cod] *.wav *.npz *.pkl .DS_Store
